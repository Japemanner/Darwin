VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SNYK_API_KEY=your-snyk-api-key
GITHUB_TOKEN=your-github-personal-access-token

# PostHog (EU Cloud) — product analytics
# Vraag de project key op via https://eu.posthog.com (EU Cloud, NOOIT US)
# Productie-waarden MOETEN ook in Netlify dashboard → Site settings → Environment variables staan
VITE_PUBLIC_POSTHOG_KEY=phc_your-posthog-project-key
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Web Push (feature 018) — VAPID public key, NON-SECRET and safe in the bundle.
# Generate the pair with `node scripts/generate-vapid-keys.mjs`; store the JSON
# (both keys) as the Supabase secret VAPID_KEYS and only paste the base64url
# public key here. Also set this value in Netlify → Environment variables.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Risico-analyse API (mock-first)
# Lokaal: draai `node scripts/mock-analysis-server.mjs` en gebruik onderstaande URL
# Productie: Darwin backend-endpoint (zie specs/008-risico-analyse-ui/contracts/)
VITE_ANALYSIS_API_URL=http://localhost:4010

# E2E-testaccounts (Playwright, tests/e2e/fixtures.ts)
# E2E_EMAIL/E2E_PASSWORD: beheerder (role=admin) — gebruikt door de standaard page-fixture
# E2E_MEMBER_EMAIL/E2E_MEMBER_PASSWORD: adviseur (role=member) — gebruikt door de
#   memberPage-fixture en scripts/rls-verify.mjs (RLS-verificatie, feature 010)
# Zonder deze variabelen skippen de betreffende tests met een duidelijke reden.
E2E_EMAIL=e2e-admin@example.com
E2E_PASSWORD=your-e2e-admin-password
E2E_MEMBER_EMAIL=e2e-member@example.com
E2E_MEMBER_PASSWORD=your-e2e-member-password

# Platformbeheerder (feature 019) — gebruikt door de platformAdminPage-fixture
# en de platformbeheer-tests. Gebruik een ander account dan E2E_EMAIL.
E2E_PLATFORM_ADMIN_EMAIL=platform-admin@example.com
E2E_PLATFORM_ADMIN_PASSWORD=your-platform-admin-password

# Organisatie waartegen de schakeltests draaien; zonder deze variabele skippen
# die tests. Het lid-account (E2E_MEMBER_EMAIL) moet in deze organisatie zitten.
E2E_TEST_ORG_NAME=your-test-organization

# Teambeheer (feature 020) — block/unblock testtarget en uitnodigingsadres.
# De block-target is een adviseur in E2E_TEST_ORG_NAME; de test deblokkeert
# dit account altijd in afterAll.
E2E_BLOCK_TARGET_EMAIL=block-target@example.com
E2E_BLOCK_TARGET_PASSWORD=your-block-target-password
# Plus-adres; de test maakt daar naam+e2e-<timestamp>@domein.nl van.
E2E_INVITE_EMAIL_BASE=invite+e2e@example.com
